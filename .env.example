# Server Configuration
NODE_ENV=development
PORT=3000

# Database (Neon PostgreSQL)
# Pooled connection for your application (note the -pooler suffix)
DATABASE_URL="postgresql://username:password@ep-xxx-pooler.c-2.us-east-1.aws.neon.tech/database?sslmode=require&channel_binding=require"
# Direct connection for Prisma CLI (migrations, introspection)
DIRECT_URL="postgresql://username:password@ep-xxx.c-2.us-east-1.aws.neon.tech/database?sslmode=require&channel_binding=require"

# JWT Secret (Generate secure random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=1d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
